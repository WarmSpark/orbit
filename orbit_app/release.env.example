# Orbit release build configuration — copy to `release.env` and fill in.
#
#   cp release.env.example release.env
#   # edit release.env, then:
#   ./scripts/build-release.sh
#
# release.env is gitignored (it names your production host). These values are
# baked into the APK at build time via --dart-define.

# HTTPS base URL of your deployed backend. MUST be https:// for a release build
# (the app blocks cleartext HTTP outside debug). No trailing slash.
# Example: https://orbit-xxxx.herokuapp.com
ORBIT_BASE_URL=

# The *Web* OAuth client ID from Google Cloud Console → Credentials.
# MUST match the backend's GOOGLE_CLIENT_ID config var exactly.
# (This is not a secret — it ships inside the APK — so it's fine to keep here.)
ORBIT_GOOGLE_CLIENT_ID=81704897904-qs2j4m7326j4b5qkmtco60j8ri7r77q4.apps.googleusercontent.com
